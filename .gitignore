# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---- Agent Team 项目自定义忽略 ----

# Python 虚拟环境与字节码
server/.venv/
server/**/__pycache__/
*.py[cod]
*.egg-info/

# 后端运行时数据（SQLite 数据库、本地工作空间映射等业务数据）。
# 注意：仅忽略运行时生成的 db/json 产物，保留 data/ 下的源码（*.py、names.json）。
server/data/*.db
server/data/*.db-*
server/data/shared_workspaces.json

# 本地模式工作空间（成员 top 工作目录 / .self 记忆）与运行时输出目录
workspaces/
server/workspaces/
**/.output/

# 一次性调试/探针脚本与临时产物（P6 仓库卫生）
/tmp/
server/tmp*.py
/tmp_*.py
/tmp/repro*
server/**/*.probe.txt

# 模型配置文件含 API Key 密钥，不提交；请参照 *.example.yaml 创建
server/configs/models/*.yaml
!server/configs/models/*.example.yaml

# 嵌入模型配置文件含 API Key 密钥，不提交
server/configs/embed_model.yaml

# 本地 VS Code 扩展安装包
*.vsix

# 本地运行日志
*.log
server/*.log

# 后端统一运行日志目录（server/logs/app.log 及滚动副本）
server/logs/

# SFT 数据收集运行时产物（server/data/sft/sft_YYYYMMDD.jsonl）
server/data/sft/
